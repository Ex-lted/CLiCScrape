{
  "manifest_version": 3,
  "name": "CLiCScrape",
  "version": "0.1.0",
  "description": "Retrieve class options from MMU CLiC pages you open yourself, then build clash-free timetables. Everything stays in your browser.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://clic.mmu.edu.my/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.js", "parser.js", "scheduler.js", "store.js", "guide.js", "styles.js"],
      "matches": ["https://clic.mmu.edu.my/*"]
    }
  ]
}
